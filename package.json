{
  "name": "engineering-ai-console",
  "version": "0.1.0",
  "description": "Local master console for engineering AI ideation, execution-instruction dispatch and audit distillation. OpenAI/Anthropic compatible, offline attachment parsing, static fallback.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "rspack serve -c rspack.config.ts",
    "build": "rspack build -c rspack.config.ts && node scripts/third-party-licenses.mjs",
    "type": "tsc -p tsconfig.json",
    "lint": "oxlint src rspack.config.ts",
    "format": "oxfmt --write .",
    "test": "node tests/run-selftest.mjs",
    "test:logic": "node tests/run-logic-selftest.mjs",
    "test:docs": "node tests/run-browser-selftest.mjs",
    "test:server": "python tests/server_selftest.py",
    "test:privacy": "node tests/privacy-scan.mjs"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "fflate": "0.8.3",
    "idb": "8.0.3",
    "katex": "0.16.22",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "mermaid": "11.10.1",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-llm-math": "3.1.0",
    "prismjs": "1.30.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zustand": "4.4.7"
  },
  "devDependencies": {
    "@rspack/cli": "2.0.2",
    "@rspack/core": "2.0.2",
    "@rspack/dev-server": "2.0.1",
    "@swc/helpers": "0.5.23",
    "@types/katex": "^0.16.5",
    "@types/mdast": "~4.0.3",
    "@types/node": "~20.9.2",
    "@types/prismjs": "^1.26.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.0",
    "oxfmt": "0.48.0",
    "oxlint": "1.63.0",
    "typescript": "7.0.2"
  }
}
